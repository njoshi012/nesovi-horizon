<section class="nesovi-shop">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.show_filters %}
    <div class="nesovi-filters">
      <button class="nesovi-fbtn active" data-f="all">All</button>
      {% for c in section.settings.collections %}
        <button class="nesovi-fbtn" data-f="{{ c.handle }}">{{ c.title }}</button>
      {% endfor %}
      {% comment %} {% if section.settings.show_price_filter %}
        <button class="nesovi-fbtn" data-f="under-price">Under {{ section.settings.price_cap | times: 100 | money_without_trailing_zeros }}</button>
      {% endif %} {% endcomment %}
    </div>
  {% endif %}

  <div class="nesovi-pgrid" id="nesoviPGrid">
    {% for c in section.settings.collections %}
      {% for product in c.products limit: section.settings.limit %}
        {% assign first_variant = product.first_available_variant %}
        {% assign images = product.images %}
        {% assign img_count = images | size %}

        {%- comment -%} rating (Shopify Product Reviews metafield) {%- endcomment -%}
        {%- assign rating = product.metafields.reviews.rating.value -%}

        <div class="nesovi-pcard"
             data-collection="{{ c.handle }}"
             data-pid="{{ product.id }}"
             data-price="{{ product.price | divided_by: 100 }}">

          {%- comment -%} ── IMAGE SLIDER ── {%- endcomment -%}
          <div class="nesovi-pimg">

            {%- comment -%} BUY 2 GET 1 ribbon (driven by product tag) {%- endcomment -%}
            {% if product.tags contains section.settings.ribbon_tag %}
              <span class="nesovi-ribbon">{{ section.settings.ribbon_text }}</span>
            {% endif %}

            <div class="nesovi-track" id="track-{{ product.id }}-{{ forloop.parentloop.index }}">
              {% for img in images %}
                <div class="nesovi-slide">
                  <a href="{{ product.url }}" tabindex="-1" aria-label="{{ product.title | escape }}">
                    <img
                      src="{{ img | image_url: width: 520 }}"
                      srcset="{{ img | image_url: width: 360 }} 360w, {{ img | image_url: width: 520 }} 520w, {{ img | image_url: width: 720 }} 720w"
                      sizes="(max-width: 768px) 50vw, 280px"
                      alt="{{ img.alt | default: product.title | escape }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="520" height="650">
                  </a>
                </div>
              {% endfor %}
            </div>

            {% if img_count > 1 %}
              <div class="nesovi-dots" id="dots-{{ product.id }}-{{ forloop.parentloop.index }}">
                {% for img in images %}
                  <span class="nesovi-dot{% if forloop.first %} active{% endif %}"></span>
                {% endfor %}
              </div>
            {% endif %}

            {%- comment -%} rating pill (bottom-left) {%- endcomment -%}
            {% if rating and rating.rating > 0 %}
              <span class="nesovi-rating" aria-label="Rated {{ rating.rating }} out of 5">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 .8l1.6 3.3 3.6.5-2.6 2.5.6 3.6L6 9.5 2.8 11.3l.6-3.6L.8 4.6l3.6-.5z"/></svg>
                {{ rating.rating | round: 1 }}
              </span>
            {% endif %}
          </div>

          {%- comment -%} ── PRODUCT INFO ── {%- endcomment -%}
          <div class="nesovi-pinfo">
            <a href="{{ product.url }}" class="nesovi-ptitle">{{ product.title }}</a>

            <div class="nesovi-pricing">
              <span class="nesovi-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                {% assign saving = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="nesovi-price-sub">
                  <span class="nesovi-compare">{{ product.compare_at_price | money }}</span>
                  <span class="nesovi-off">({{ saving }}% Off)</span>
                </span>
              {% endif %}
            </div>

            {%- comment -%} ── ATC BUTTON ── {%- endcomment -%}
            {% if first_variant and first_variant.available %}
              <button class="nesovi-atc"
                data-variant="{{ first_variant.id }}"
                data-title="{{ product.title | escape }}"
                aria-label="Add {{ product.title | escape }} to cart">
                <span class="nesovi-atc-label">Add To Cart</span>
                <span class="nesovi-atc-loading" aria-hidden="true">
                  <svg class="nesovi-spin" width="15" height="15" viewBox="0 0 14 14"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="2" stroke-dasharray="22" stroke-dashoffset="8" fill="none"/></svg>
                </span>
                <span class="nesovi-atc-done" aria-hidden="true">✓ Added</span>
              </button>
            {% else %}
              <button class="nesovi-atc nesovi-atc--soldout" disabled>Sold Out</button>
            {% endif %}
          </div>
        </div>

      {% endfor %}
    {% endfor %}
  </div>

  <p class="nesovi-empty" id="nesoviEmpty" style="display:none">No products found in this category.</p>
</section>

<style>
/* ── Shell ── */
.nesovi-shop{padding:40px 16px;background:#fff}
.nesovi-shop h2{font-size:24px;font-weight:600;text-transform:capitalize;text-align:center;margin:0 0 22px;color:#1a1a1a}

/* ── Filter pills ── */
.nesovi-filters{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:26px}
.nesovi-fbtn{padding:8px 18px;border:1px solid #e0e0e0;background:#fff;border-radius:20px;font-size:13px;cursor:pointer;color:#555;transition:all .15s;white-space:nowrap}
.nesovi-fbtn.active,.nesovi-fbtn:hover{background:#1a1a1a;color:#fff;border-color:#1a1a1a}

/* ── Grid ── */
.nesovi-pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1200px;margin:0 auto}
@media(max-width:1100px){.nesovi-pgrid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:768px){.nesovi-pgrid{grid-template-columns:repeat(2,1fr);gap:12px}
  .nesovi-filters{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none}
  .nesovi-filters::-webkit-scrollbar{display:none}
  .nesovi-fbtn{flex:0 0 auto}}
@media(max-width:380px){.nesovi-pgrid{gap:10px}}

/* ── Card ── */
.nesovi-pcard{border:1px solid #ececec;border-radius:10px;overflow:hidden;color:inherit;background:#fff;transition:border-color .15s,box-shadow .15s;display:flex;flex-direction:column}
.nesovi-pcard:hover{box-shadow:0 6px 20px rgba(0,0,0,.10)}
.nesovi-pcard.hide{display:none!important}

/* ── Image / slider ── */
.nesovi-pimg{position:relative;aspect-ratio:4/5;background:#f6f4f2;overflow:hidden}
.nesovi-track{display:flex;height:100%;transition:transform .35s cubic-bezier(.4,0,.2,1);will-change:transform}
.nesovi-slide{flex:0 0 100%;height:100%}
.nesovi-slide a{display:block;width:100%;height:100%}
.nesovi-slide img{width:100%;height:100%;object-fit:cover;display:block}

/* ── Dots ── */
.nesovi-dots{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);display:flex;gap:4px;z-index:3}
.nesovi-dot{width:5px;height:5px;border-radius:50%;background:rgba(0,0,0,.25);transition:background .2s,width .2s;display:block}
.nesovi-dot.active{background:#1a1a1a;width:14px;border-radius:3px}

/* ── BUY 2 GET 1 ribbon ── */
.nesovi-ribbon{position:absolute;top:12px;left:0;background:#f4c7c1;color:#7a2e2e;font-size:10px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;padding:4px 14px 4px 9px;z-index:4;clip-path:polygon(0 0,100% 0,calc(100% - 7px) 50%,100% 100%,0 100%);pointer-events:none}

/* ── Rating pill ── */
.nesovi-rating{position:absolute;bottom:8px;left:8px;background:#fff;border-radius:6px;padding:2px 7px;font-size:11px;font-weight:600;color:#333;display:flex;align-items:center;gap:3px;box-shadow:0 1px 4px rgba(0,0,0,.16);z-index:3}
.nesovi-rating svg{color:#f5a623}

/* ── Info ── */
.nesovi-pinfo{padding:11px 12px 12px;display:flex;flex-direction:column}
.nesovi-ptitle{font-size:13.5px;font-weight:500;color:#1a1a1a;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.35;min-height:37px;margin-bottom:8px}
.nesovi-ptitle:hover{color:#8B4A32}
.nesovi-pricing{display:flex;flex-direction:column;gap:3px;margin-bottom:10px;height:40px}
.nesovi-price{font-size:14px;font-weight:700;color:#1a1a1a}
.nesovi-price-sub{display:flex;align-items:center;gap:6px;flex-wrap:nowrap;overflow:hidden}
.nesovi-compare{font-size:12px;color:#777;text-decoration:line-through;white-space:nowrap;flex-shrink:0}
.nesovi-off{color:#1f9d55;font-size:12px;font-weight:600;white-space:nowrap}

/* ── ATC button (solid black, full width) ── */
.nesovi-atc{width:100%;height:36px;padding:0 10px;border-radius:6px;border:none;background:#111;color:#fff;font-size:13px;font-weight:600;letter-spacing:.02em;cursor:pointer;position:relative;overflow:hidden;transition:background .2s;display:flex;align-items:center;justify-content:center;gap:6px;flex-shrink:0;margin-top:auto}
.nesovi-atc:hover:not(:disabled){background:#000}
.nesovi-atc--soldout{background:#eee;color:#999;cursor:not-allowed}

/* button state layers */
.nesovi-atc-label{transition:opacity .15s;padding:10px}
.nesovi-atc-loading,.nesovi-atc-done{position:absolute;opacity:0;transition:opacity .15s;pointer-events:none}
.nesovi-atc.is-loading .nesovi-atc-label{opacity:0}
.nesovi-atc.is-loading .nesovi-atc-loading{opacity:1}
.nesovi-atc.is-added{background:#1f9d55}
.nesovi-atc.is-added .nesovi-atc-label{opacity:0}
.nesovi-atc.is-added .nesovi-atc-done{opacity:1}

@keyframes nesovi-spin{to{transform:rotate(360deg)}}
.nesovi-spin{animation:nesovi-spin .7s linear infinite}

.nesovi-empty{text-align:center;color:#999;font-size:14px;margin-top:24px}
</style>

<script>
(function(){
  /* ── SLIDER ── */
  var sliders = {};

  function initSlider(trackId){ sliders[trackId] = { current: 0 }; }

  function slideTo(trackId, dotsId, total, idx){
    var state = sliders[trackId];
    if(!state) return;
    state.current = ((idx % total) + total) % total;
    var track = document.getElementById(trackId);
    if(track) track.style.transform = 'translateX(-' + (state.current * 100) + '%)';
    var dotsEl = document.getElementById(dotsId);
    if(dotsEl){
      var dots = dotsEl.querySelectorAll('.nesovi-dot');
      dots.forEach(function(d,i){ d.classList.toggle('active', i === state.current); });
    }
  }

  /* touch swipe */
  document.querySelectorAll('.nesovi-pimg').forEach(function(img){
    var sx = 0;
    img.addEventListener('touchstart', function(e){ sx = e.changedTouches[0].clientX; }, { passive: true });
    img.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - sx;
      if(Math.abs(dx) < 30) return;
      var track = img.querySelector('.nesovi-track');
      if(!track) return;
      var dotsEl = img.querySelector('.nesovi-dots');
      if(!dotsEl) return;
      var total = dotsEl.querySelectorAll('.nesovi-dot').length;
      var state = sliders[track.id];
      if(state) slideTo(track.id, dotsEl.id, total, state.current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  });

  document.querySelectorAll('.nesovi-track').forEach(function(t){ initSlider(t.id); });

  /* ── ATC ── */
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.nesovi-atc:not(:disabled):not(.is-loading):not(.is-added)');
    if(!btn) return;
    var variantId = btn.dataset.variant;
    if(!variantId) return;

    btn.classList.add('is-loading');
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
    })
    .then(function(r){ if(!r.ok) throw new Error('fail'); return r.json(); })
    .then(function(){
      btn.classList.remove('is-loading');
      btn.classList.add('is-added');

      fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            resource: cart,
            sourceId: variantId,
            data: {
              didError: false,
              source: 'nesovi-shop-grid',
              itemCount: cart.item_count,
              variantId: variantId
            }
          }
        }));
      }).catch(function(){});

      setTimeout(function(){
        btn.classList.remove('is-added');
        btn.disabled = false;
      }, 2500);
    })
    .catch(function(){
      btn.classList.remove('is-loading');
      btn.disabled = false;
      alert('Could not add to cart. Please try again.');
    });
  });

  /* ── FILTER ── */
  var btns = document.querySelectorAll('.nesovi-fbtn');
  var cards = Array.prototype.slice.call(document.querySelectorAll('.nesovi-pcard'));
  var empty = document.getElementById('nesoviEmpty');
  var cap = {{ section.settings.price_cap | default: 200 }};

  function apply(f){
    var visible = 0, seen = {};
    cards.forEach(function(c){
      var col = c.dataset.collection, pid = c.dataset.pid, p = parseFloat(c.dataset.price) || 0, show = false;
      if(f === 'all'){ show = !seen[pid]; }
      else if(f === 'under-price'){ show = p < cap && !seen[pid]; }
      else { show = col === f; }
      if(show && (f === 'all' || f === 'under-price')) seen[pid] = true;
      c.classList.toggle('hide', !show);
      if(show) visible++;
    });
    if(empty) empty.style.display = visible ? 'none' : 'block';
  }

  btns.forEach(function(b){
    b.addEventListener('click', function(){
      btns.forEach(function(x){ x.classList.remove('active'); });
      b.classList.add('active');
      apply(b.dataset.f);
    });
  });

  apply('all');
})();
</script>

{% schema %}
{
  "name": "NESOVI Shop Grid",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Discover Your Style"},
    {"type": "collection_list", "id": "collections", "label": "Collections (each becomes a filter pill)", "limit": 8},
    {"type": "range", "id": "limit", "label": "Max products per collection", "min": 4, "max": 50, "step": 2, "default": 12},
    {"type": "checkbox", "id": "show_filters", "label": "Show filter pills", "default": true},
    {"type": "checkbox", "id": "show_price_filter", "label": "Show price filter pill", "default": true},
    {"type": "range", "id": "price_cap", "label": "Price filter cap (₹)", "min": 100, "max": 2000, "step": 50, "default": 200},
    {"type": "header", "content": "Promo ribbon"},
    {"type": "text", "id": "ribbon_text", "label": "Ribbon text", "default": "BUY 2 GET 1"},
    {"type": "text", "id": "ribbon_tag", "label": "Show ribbon on products with this tag", "default": "buy2get1", "info": "Add this tag to a product in Shopify admin to display the ribbon."}
  ],
  "presets": [{"name": "NESOVI Shop Grid"}]
}
{% endschema %}
