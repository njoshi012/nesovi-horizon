<section class="nesovi-fbt" data-pid="{{ product.id }}" data-limit="{{ section.settings.limit }}">
  <h2>{{ section.settings.heading }}</h2>
  <p class="nesovi-fbt-sub">{{ section.settings.subheading }}</p>
  <div class="nesovi-fbt-row">
    <a href="{{ product.url }}" class="nesovi-fbt-main">
      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 300 }}" alt="" loading="lazy">{% endif %}
      <span>{{ product.title }}</span>
    </a>
    <span class="nesovi-fbt-plus">+</span>
    <div class="nesovi-fbt-grid"></div>
  </div>
  <div class="nesovi-fbt-foot">
    <span class="nesovi-fbt-total">{{ section.settings.total_label }} <strong class="nesovi-fbt-price" data-cents="{{ product.price }}">{{ product.price | money }}</strong></span>
    <button type="button" class="nesovi-fbt-add">{{ section.settings.button_label }}</button>
  </div>
</section>
{% stylesheet %}
.nesovi-fbt{padding:40px 24px;max-width:1000px;margin:0 auto;text-align:center}
.nesovi-fbt h2{font-size:24px;font-weight:600;text-transform:capitalize;margin:0 0 6px;color:#1a1a1a}
.nesovi-fbt-sub{font-size:13px;color:#666;margin:0 0 24px}
.nesovi-fbt-row{display:flex;align-items:center;gap:14px;justify-content:center;flex-wrap:wrap}
.nesovi-fbt-main,.nesovi-fbt-item{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:inherit;width:120px}
.nesovi-fbt-main img,.nesovi-fbt-item img{width:100px;height:100px;object-fit:cover;border-radius:10px;border:2px solid #5b6ef5;background:#f5f5f5}
.nesovi-fbt-item img{border-color:#e0e0e0}
.nesovi-fbt-main span,.nesovi-fbt-item span{font-size:11px;margin-top:6px;color:#1a1a1a}
.nesovi-fbt-plus{font-size:22px;color:#999}
.nesovi-fbt-grid{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
.nesovi-fbt-item{position:relative;cursor:pointer}
.nesovi-fbt-item input{position:absolute;top:6px;left:6px;width:16px;height:16px}
.nesovi-fbt-foot{margin-top:24px;display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap}
.nesovi-fbt-total{font-size:14px;color:#444}
.nesovi-fbt-price{font-size:18px;color:#1a1a1a;margin-left:6px}
.nesovi-fbt-add{padding:11px 26px;background:#5b6ef5;color:#fff;border:none;border-radius:8px;font-weight:500;font-size:14px;cursor:pointer}
.nesovi-fbt-add:hover{background:#4a5ce0}
{% endstylesheet %}
{% javascript %}
(function(){
  function money(c){return '\u20b9'+(c/100).toFixed(2).replace(/\.00$/,'')}
  document.querySelectorAll('.nesovi-fbt').forEach(function(sec){
    if(sec.dataset.nesoviInit)return;sec.dataset.nesoviInit='1';
    var g=sec.querySelector('.nesovi-fbt-grid'),pid=sec.dataset.pid,limit=sec.dataset.limit;
    var priceEl=sec.querySelector('.nesovi-fbt-price'),addBtn=sec.querySelector('.nesovi-fbt-add');
    var base=parseInt(priceEl.dataset.cents||0);
    fetch('/recommendations/products.json?product_id='+pid+'&limit='+limit+'&intent=complementary')
      .then(function(r){return r.json()})
      .then(function(d){
        var recs=(d.products||[]).slice(0,limit);
        if(!recs.length){sec.style.display='none';return;}
        g.innerHTML=recs.map(function(p,i){
          var img=p.featured_image?p.featured_image.replace(/(\.[a-z]+)(\?|$)/,'_300x$1$2'):'';
          var v=p.variants&&p.variants[0]?p.variants[0]:null;
          return '<label class="nesovi-fbt-item"><input type="checkbox" checked data-price="'+(v?v.price:0)+'" data-vid="'+(v?v.id:'')+'"><img src="'+img+'" alt="" loading="lazy"><span>'+p.title+'</span></label>';
        }).join('');
        function recalc(){
          var total=base;
          g.querySelectorAll('input:checked').forEach(function(c){total+=parseInt(c.dataset.price);});
          priceEl.textContent=money(total);
        }
        g.querySelectorAll('input').forEach(function(c){c.addEventListener('change',recalc);});
        addBtn.addEventListener('click',function(){
          var items=[{id:{{ product.selected_or_first_available_variant.id }},quantity:1}];
          g.querySelectorAll('input:checked').forEach(function(c){if(c.dataset.vid)items.push({id:parseInt(c.dataset.vid),quantity:1});});
          addBtn.disabled=true;addBtn.textContent='Adding\u2026';
          fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})})
            .then(function(r){return r.json()})
            .then(function(){
              addBtn.textContent='Added \u2713';
              return fetch('/cart.js').then(function(r){return r.json()}).then(function(cart){
                document.dispatchEvent(new CustomEvent('cart:update',{bubbles:true,detail:{resource:cart,data:{source:'nesovi-fbt'}}}));
                setTimeout(function(){addBtn.disabled=false;addBtn.textContent='{{ section.settings.button_label }}';},1500);
              });
            });
        });
      }).catch(function(){sec.style.display='none';});
  });
})();
{% endjavascript %}
{% schema %}
{
  "name": "NESOVI Bought Together",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "🔗 Frequently Bought Together"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Add the bundle to your cart with one click."},
    {"type": "range", "id": "limit", "label": "Companion products", "min": 1, "max": 3, "step": 1, "default": 2},
    {"type": "text", "id": "total_label", "label": "Total label", "default": "Total:"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Add Bundle to Cart"}
  ],
  "presets": [{"name": "NESOVI Bought Together"}]
}
{% endschema %}