<section class="nesovi-hero">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
  <a href="{{ section.settings.button_link }}" class="nesovi-hero-cta">{{ section.settings.button_label }}</a>
  <div class="nesovi-trust-bar">
    <span>🛡️</span>
    <p><strong>{{ section.settings.trust_text }}</strong></p>
  </div>
</section>
<style>
.nesovi-hero{background:linear-gradient(135deg,#f3f0ff 0%,#fef3e2 100%);padding:64px 24px 48px;text-align:center}
.nesovi-hero h1{font-size:36px;font-weight:500;line-height:1.3;margin:0 0 12px;color:#1a1a1a}
.nesovi-hero p{font-size:16px;color:#666;margin:0 0 24px}
.nesovi-hero-cta{display:inline-block;padding:12px 28px;background:#5b6ef5;color:#fff;border-radius:8px;text-decoration:none;font-weight:500;font-size:15px;transition:background .15s}
.nesovi-hero-cta:hover{background:#4a5ce0}
.nesovi-trust-bar{margin-top:32px;display:flex;align-items:center;justify-content:center;gap:8px}
.nesovi-trust-bar span{font-size:20px}
.nesovi-trust-bar p{font-size:13px;color:#333;margin:0}
@media(max-width:768px){.nesovi-hero h1{font-size:26px}.nesovi-hero{padding:48px 16px 36px}}
</style>
{% schema %}
{
  "name": "NESOVI Hero",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "True Anti-Tarnish Jewelry. Tried & Tested."},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Premium quality. All price points. All pieces."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now ↗"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "text", "id": "trust_text", "label": "Trust bar text", "default": "Backed by 1000+ customers — all NESOVI jewelry is premium anti-tarnish"}
  ],
  "presets": [{"name": "NESOVI Hero"}]
}
{% endschema %}