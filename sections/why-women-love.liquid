<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="why-women-love color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="why-women-love__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="why-women-love__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="why-women-love__item" {{ block.shopify_attributes }}>
          <span class="why-women-love__icon">
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '48px', alt: block.settings.text | escape
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'why-women-love__icon-placeholder' }}
            {%- endif -%}
          </span>
          {%- if block.settings.text != blank -%}
            <span class="why-women-love__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .why-women-love {
    text-align: center;
    padding-inline: 16px;
  }

  .why-women-love__heading {
    margin: 0 0 var(--padding-lg, 2rem);
    font-size: 24px;
    font-weight: 600;
    text-transform: capitalize;
    color: var(--color-foreground-heading);
  }

  .why-women-love__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--padding-lg, 2rem) var(--padding-sm, 0.7rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .why-women-love__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .why-women-love__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs, 0.5rem);
  }

  .why-women-love__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    color: var(--color-primary);
  }

  .why-women-love__icon img,
  .why-women-love__icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .why-women-love__icon-placeholder {
    opacity: 0.35;
  }

  .why-women-love__text {
    font-size: var(--font-size--xs, 0.8125rem);
    line-height: 1.35;
    color: var(--color-foreground);
    max-width: 9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why women love us",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Women Love Nesovi Jewelry"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Why women love us",
      "category": "Promotional",
      "blocks": {
        "i1": { "type": "item", "settings": { "text": "Doesn't tarnish easily" } },
        "i2": { "type": "item", "settings": { "text": "Sweat & water resistant" } },
        "i3": { "type": "item", "settings": { "text": "Safe for sensitive skin" } },
        "i4": { "type": "item", "settings": { "text": "Lightweight & comfortable" } },
        "i5": { "type": "item", "settings": { "text": "Perfect for everyday wear" } },
        "i6": { "type": "item", "settings": { "text": "Gift ready packaging" } }
      },
      "block_order": ["i1", "i2", "i3", "i4", "i5", "i6"]
    }
  ]
}
{% endschema %}
