{% assign p = product %}
<section class="nesovi-pdp">
  <div class="nesovi-pdp-grid">
    <div class="nesovi-pdp-gallery">
      <div class="nesovi-pdp-main"><img id="nesoviMainImg" src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.title | escape }}" width="900" height="900"></div>
      {% if p.images.size > 1 %}
      <div class="nesovi-pdp-thumbs">
        {% for img in p.images limit: 5 %}
          <img src="{{ img | image_url: width: 160 }}" data-full="{{ img | image_url: width: 900 }}" class="nesovi-thumb{% if forloop.first %} active{% endif %}" alt="" width="160" height="160">
        {% endfor %}
      </div>
      {% endif %}
    </div>
    <div class="nesovi-pdp-info">
      {% assign firstcol = p.collections.first %}
      {% if firstcol %}<span class="nesovi-pdp-badge">{{ firstcol.title }}</span>{% endif %}
      <h1>{{ p.title }}</h1>
      {% if section.settings.show_rating %}<div class="nesovi-pdp-rating">⭐⭐⭐⭐⭐ <span>{{ section.settings.rating_text }}</span></div>{% endif %}
      <div class="nesovi-pdp-guarantee">
        <strong>🛡️ {{ section.settings.guarantee_title }}</strong>
        <p>{{ section.settings.guarantee_text }}</p>
      </div>
      <div class="nesovi-pdp-price">
        <span id="nesoviPrice-{{ section.id }}">{{ p.selected_or_first_available_variant.price | money }}</span>
        {% if p.compare_at_price > p.price %}<s id="nesoviCompare-{{ section.id }}">{{ p.compare_at_price | money }}</s>{% endif %}
      </div>
      {% if section.settings.specs != blank %}
      <div class="nesovi-pdp-specs">
        {% assign rows = section.settings.specs | split: ',' %}
        {% for r in rows %}<div>✓ {{ r | strip }}</div>{% endfor %}
      </div>
      {% endif %}
      {% form 'product', p, id: 'nesoviPForm-' | append: section.id %}
        <input type="hidden" name="id" id="nesoviVid-{{ section.id }}" value="{{ p.selected_or_first_available_variant.id }}">
        {% unless p.has_only_default_variant %}
          {% for option in p.options_with_values %}
            <div class="nesovi-pdp-opt">
              <label>{{ option.name }}</label>
              <select class="nesovi-opt-sel" data-index="{{ forloop.index0 }}">
                {% for value in option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}
              </select>
            </div>
          {% endfor %}
        {% endunless %}
        <div class="nesovi-pdp-actions">
          <div class="nesovi-qty">
            <button type="button" class="nesovi-qm">−</button>
            <input type="number" name="quantity" class="nesovi-qty-input" value="1" min="1">
            <button type="button" class="nesovi-qp">+</button>
          </div>
          <button type="submit" class="nesovi-atc" id="nesoviATC-{{ section.id }}">Add to Cart</button>
        </div>
      {% endform %}
      <div class="nesovi-pdp-trust">
        <div>🚚 Free shipping</div><div>🔄 Easy returns</div><div>📦 Safe packaging</div><div>💎 Premium quality</div>
      </div>
    </div>
  </div>
  {% if p.description != blank %}
  <div class="nesovi-pdp-desc">
    <h2>About This Piece</h2>
    <div>{{ p.description }}</div>
  </div>
  {% endif %}
</section>
{% stylesheet %}
.nesovi-pdp{padding:32px 24px;background:#fff;max-width:1100px;margin:0 auto}
.nesovi-pdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.nesovi-pdp-main{aspect-ratio:1;border-radius:12px;overflow:hidden;background:#f5f5f5}
.nesovi-pdp-main img{width:100%;height:100%;object-fit:cover}
.nesovi-pdp-thumbs{display:flex;gap:10px;margin-top:12px}
.nesovi-thumb{width:64px;height:64px;border-radius:8px;object-fit:cover;cursor:pointer;border:2px solid transparent;transition:border-color .15s}
.nesovi-thumb.active,.nesovi-thumb:hover{border-color:#5b6ef5}
.nesovi-pdp-badge{display:inline-block;background:#5b6ef5;color:#fff;font-size:11px;padding:4px 12px;border-radius:20px;margin-bottom:12px}
.nesovi-pdp-info h1{font-size:24px;font-weight:500;margin:0 0 10px;color:#1a1a1a}
.nesovi-pdp-rating{font-size:13px;margin-bottom:14px}
.nesovi-pdp-rating span{color:#666}
.nesovi-pdp-guarantee{background:#fff8e1;border:1px solid #ffe082;border-radius:8px;padding:14px 16px;margin-bottom:16px}
.nesovi-pdp-guarantee strong{font-size:13px;color:#1a1a1a}
.nesovi-pdp-guarantee p{font-size:12px;color:#555;margin:4px 0 0}
.nesovi-pdp-price{font-size:26px;font-weight:500;margin-bottom:14px;color:#1a1a1a}
.nesovi-pdp-price s{font-size:15px;color:#999;margin-left:10px}
.nesovi-pdp-specs{background:#f5f5f5;border-radius:8px;padding:14px 16px;margin-bottom:18px;font-size:13px;color:#444}
.nesovi-pdp-specs div{margin-bottom:5px}
.nesovi-pdp-opt{margin-bottom:14px}
.nesovi-pdp-opt label{display:block;font-size:13px;font-weight:500;margin-bottom:6px}
.nesovi-opt-sel{width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:13px}
.nesovi-pdp-actions{display:flex;gap:12px;margin:18px 0}
.nesovi-qty{display:flex;border:1px solid #ddd;border-radius:8px;overflow:hidden}
.nesovi-qty button{width:36px;border:none;background:#fff;cursor:pointer;font-size:16px}
.nesovi-qty-input{width:44px;text-align:center;border:none;border-left:1px solid #ddd;border-right:1px solid #ddd;font-size:14px}
.nesovi-atc{flex:1;padding:13px;background:#5b6ef5;color:#fff;border:none;border-radius:8px;font-weight:500;font-size:15px;cursor:pointer;transition:background .15s}
.nesovi-atc:hover{background:#4a5ce0}
.nesovi-pdp-trust{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.nesovi-pdp-trust div{background:#f5f5f5;border-radius:8px;padding:10px;text-align:center;font-size:12px;color:#444}
.nesovi-pdp-desc{margin-top:48px;border-top:1px solid #eee;padding-top:32px}
.nesovi-pdp-desc h2{font-size:18px;font-weight:500;margin:0 0 14px}
.nesovi-pdp-desc div{font-size:14px;color:#555;line-height:1.7}
@media(max-width:768px){.nesovi-pdp-grid{grid-template-columns:1fr}}
{% endstylesheet %}
{% javascript %}
(function(){
  document.querySelectorAll('.nesovi-pdp').forEach(function(root){
    if(root.dataset.nesoviInit)return;root.dataset.nesoviInit='1';
    var dataEl=root.querySelector('[data-variants]');
    var variantsJson=root.dataset.variants;
    var thumbs=root.querySelectorAll('.nesovi-thumb'),mainImg=root.querySelector('.nesovi-pdp-main img');
    thumbs.forEach(function(t){t.addEventListener('click',function(){
      mainImg.src=t.dataset.full;
      thumbs.forEach(function(x){x.classList.remove('active')});t.classList.add('active');
    });});
    var qtyInput=root.querySelector('.nesovi-qty-input');
    var qm=root.querySelector('.nesovi-qm'),qp=root.querySelector('.nesovi-qp');
    if(qm)qm.addEventListener('click',function(){qtyInput.value=Math.max(1,parseInt(qtyInput.value)-1)});
    if(qp)qp.addEventListener('click',function(){qtyInput.value=parseInt(qtyInput.value)+1});
    var opts=root.querySelectorAll('.nesovi-opt-sel');
    if(opts.length){
      var variants=JSON.parse(root.dataset.variants||'[]');
      var idInput=root.querySelector('input[name="id"]'),price=root.querySelector('.nesovi-pdp-price span'),atc=root.querySelector('.nesovi-atc');
      function money(c){return '\u20b9'+(c/100).toFixed(2).replace(/\.00$/,'')}
      function update(){
        var sel=[];opts.forEach(function(o){sel[parseInt(o.dataset.index)]=o.value});
        var m=variants.find(function(v){return sel.every(function(s,i){return v.options[i]===s})});
        if(m){idInput.value=m.id;price.textContent=money(m.price);atc.disabled=!m.available;atc.textContent=m.available?'Add to Cart':'Sold Out';}
      }
      opts.forEach(function(o){o.addEventListener('change',update)});
    }
  });
})();
{% endjavascript %}
<script type="application/json" data-nesovi-variants-holder>{{ p.variants | json }}</script>
{% schema %}
{
  "name": "NESOVI Product",
  "settings": [
    {"type": "checkbox", "id": "show_rating", "label": "Show rating row", "default": true},
    {"type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8 · Loved by customers"},
    {"type": "text", "id": "guarantee_title", "label": "Guarantee title", "default": "Won't tarnish with daily wear"},
    {"type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "Premium anti-tarnish — tested & proven by 1000+ NESOVI customers."},
    {"type": "textarea", "id": "specs", "label": "Specs (comma separated)", "default": "18K gold-plated finish, Hypoallergenic & nickel-free, Tested 6+ months daily wear, Skin-safe for everyday use"}
  ],
  "presets": [{"name": "NESOVI Product"}]
}
{% endschema %}