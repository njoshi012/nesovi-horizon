<section class="nesovi-videos">
  <h2>{{ section.settings.heading }}</h2>
  <p class="nesovi-vid-sub">{{ section.settings.subheading }}</p>
  <div class="nesovi-vid-grid">
    {% for block in section.blocks %}
      {% assign link_url = '' %}
      {% if block.settings.link_collection != blank %}
        {% assign link_url = block.settings.link_collection.url %}
      {% elsif block.settings.link_product != blank %}
        {% assign link_url = block.settings.link_product.url %}
      {% endif %}

      <div class="nesovi-vid-card" data-video="{{ block.settings.video_url }}" {{ block.shopify_attributes }}>
        {% if block.settings.thumbnail %}
          <img src="{{ block.settings.thumbnail | image_url: width: 540 }}" alt="{{ block.settings.name }}" loading="lazy">
        {% else %}
          <div class="nesovi-vid-ph">🎥</div>
        {% endif %}

        <div class="nesovi-vid-play" aria-label="Play video">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M5 3.5l10 5.5-10 5.5V3.5z" fill="currentColor"/></svg>
        </div>

        <div class="nesovi-vid-bottom">
          <div class="nesovi-vid-name">{{ block.settings.name }}</div>
          {% if link_url != '' %}
            <a class="nesovi-vid-shoplink"
               href="{{ link_url }}"
               aria-label="Shop {{ block.settings.name }}"
               onclick="event.stopPropagation()">
              {{ block.settings.link_label | default: 'Shop Now' }}
              <svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M2 9l7-7M4 2h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<div class="nesovi-vid-modal" id="nesoviVidModal">
  <div class="nesovi-vid-modal-inner">
    <button type="button" id="nesoviVidClose" aria-label="Close video">✕</button>
    <iframe id="nesoviVidFrame" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
  </div>
</div>

<style>
.nesovi-videos{padding:48px 24px;background:#fafaf9;text-align:center}
.nesovi-videos h2{font-size:24px;font-weight:500;margin:0 0 8px;color:#1a1a1a}
.nesovi-vid-sub{font-size:14px;color:#666;margin:0 0 28px}

.nesovi-vid-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1000px;margin:0 auto}

/* Card */
.nesovi-vid-card{position:relative;aspect-ratio:9/16;border-radius:12px;overflow:hidden;cursor:pointer;background:#eee;transition:transform .15s,box-shadow .15s}
.nesovi-vid-card:hover{transform:scale(1.02);box-shadow:0 6px 20px rgba(0,0,0,.15)}
.nesovi-vid-card img{width:100%;height:100%;object-fit:cover;display:block}
.nesovi-vid-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:40px;background:linear-gradient(135deg,#f0f7ff,#f3f0ff)}

/* Play button */
.nesovi-vid-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;background:rgba(255,255,255,.92);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#8B4A32;transition:background .15s,transform .15s;pointer-events:none}
.nesovi-vid-card:hover .nesovi-vid-play{background:#fff;transform:translate(-50%,-50%) scale(1.1)}

/* Bottom overlay — name + shop link stacked */
.nesovi-vid-bottom{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.78));padding:28px 10px 12px;display:flex;flex-direction:column;gap:8px;align-items:flex-start}
.nesovi-vid-name{color:#fff;font-size:12px;font-weight:500;line-height:1.35;text-align:left}

/* Shop link button */
.nesovi-vid-shoplink{display:inline-flex;align-items:center;gap:5px;background:#8B4A32;color:#fff;font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;text-decoration:none;padding:5px 10px;border-radius:20px;transition:background .15s;white-space:nowrap}
.nesovi-vid-shoplink:hover{background:#6D3424}
.nesovi-vid-shoplink svg{flex-shrink:0}

/* Modal */
.nesovi-vid-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:9999;align-items:center;justify-content:center}
.nesovi-vid-modal.open{display:flex}
.nesovi-vid-modal-inner{position:relative;width:min(420px,92vw);aspect-ratio:9/16}
.nesovi-vid-modal-inner iframe{width:100%;height:100%;border-radius:12px}
#nesoviVidClose{position:absolute;top:-40px;right:0;background:none;border:none;color:#fff;font-size:24px;cursor:pointer;line-height:1}

@media(max-width:900px){.nesovi-vid-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.nesovi-vid-grid{grid-template-columns:repeat(2,1fr);gap:10px}}
</style>

<script>
(function(){
  var modal = document.getElementById('nesoviVidModal');
  var frame = document.getElementById('nesoviVidFrame');

  document.querySelectorAll('.nesovi-vid-card').forEach(function(c){
    c.addEventListener('click', function(e){
      if(e.target.closest('.nesovi-vid-shoplink')) return;
      var u = c.dataset.video;
      if(!u) return;
      frame.src = u;
      modal.classList.add('open');
    });
  });

  function closeModal(){
    modal.classList.remove('open');
    frame.src = '';
  }

  document.getElementById('nesoviVidClose').addEventListener('click', closeModal);
  modal.addEventListener('click', function(e){ if(e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeModal(); });
})();
</script>

{% schema %}
{
  "name": "NESOVI Videos",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "See NESOVI in Action"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Real women. Real jewelry. Real anti-tarnish proof."}
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {"type": "image_picker", "id": "thumbnail", "label": "Thumbnail (9:16)"},
        {"type": "text", "id": "name", "label": "Caption", "default": "Everyday Elegance"},
        {"type": "text", "id": "video_url", "label": "Embed URL (YouTube / Vimeo embed link)", "info": "e.g. https://www.youtube.com/embed/VIDEO_ID"},
        {"type": "collection", "id": "link_collection", "label": "Link to Collection", "info": "If set, shows a Shop Now button linking to this collection"},
        {"type": "product", "id": "link_product", "label": "Link to Product", "info": "Used only if no collection is selected above"},
        {"type": "text", "id": "link_label", "label": "Button label", "default": "Shop Now", "info": "Text shown on the link button"}
      ]
    }
  ],
  "presets": [{"name": "NESOVI Videos", "blocks": [{"type": "video"}, {"type": "video"}, {"type": "video"}, {"type": "video"}]}]
}
{% endschema %}
