{% if section.settings.specs != blank %}
<div class="nesovi-specs">
  {% assign rows = section.settings.specs | split: ',' %}
  {% for r in rows %}<div>✓ {{ r | strip }}</div>{% endfor %}
</div>
{% endif %}
{% stylesheet %}
.nesovi-specs{max-width:1100px;margin:0 auto;padding:14px 24px;background:#f5f5f5;border-radius:8px;font-size:13px;color:#444}
.nesovi-specs div{margin-bottom:5px}
{% endstylesheet %}
{% schema %}
{
  "name": "NESOVI Specs",
  "settings": [
    {"type": "textarea", "id": "specs", "label": "Specs (comma separated)", "default": "18K gold-plated finish, Hypoallergenic & nickel-free, Tested 6+ months daily wear, Skin-safe for everyday use"}
  ],
  "presets": [{"name": "NESOVI Specs"}]
}
{% endschema %}