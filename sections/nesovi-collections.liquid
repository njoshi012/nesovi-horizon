<section class="nesovi-collections">
  <h2>{{ section.settings.heading }}</h2>
  <p class="nesovi-col-sub">{{ section.settings.subheading }}</p>
  <div class="nesovi-col-grid">
    {% for block in section.blocks %}
      <div class="nesovi-col-card" {{ block.shopify_attributes }}>
        <span class="nesovi-col-badge">{{ block.settings.badge }}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.description }}</p>
        <div class="nesovi-col-price">{{ block.settings.price_range }}</div>
        <ul>
          {% assign feats = block.settings.features | split: ',' %}
          {% for f in feats %}<li>✓ {{ f | strip }}</li>{% endfor %}
        </ul>
        <a href="{{ block.settings.link }}" class="nesovi-col-cta">{{ block.settings.button_label }}</a>
      </div>
    {% endfor %}
  </div>
  <div class="nesovi-guarantee">
    <span>🛡️</span>
    <h3>{{ section.settings.guarantee_title }}</h3>
    <p>{{ section.settings.guarantee_text }}</p>
  </div>
</section>
<style>
.nesovi-collections{padding:48px 24px;background:#fff;text-align:center}
.nesovi-collections h2{font-size:24px;font-weight:600;text-transform:capitalize;margin:0 0 8px;color:#1a1a1a}
.nesovi-col-sub{font-size:14px;color:#666;margin:0 0 32px}
.nesovi-col-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:900px;margin:0 auto}
.nesovi-col-card{background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:28px 24px;text-align:left;transition:border-color .15s,box-shadow .15s}
.nesovi-col-card:hover{border-color:#5b6ef5;box-shadow:0 4px 16px rgba(91,110,245,.1)}
.nesovi-col-badge{display:inline-block;background:#5b6ef5;color:#fff;font-size:11px;padding:4px 12px;border-radius:20px;margin-bottom:12px}
.nesovi-col-card h3{font-size:18px;font-weight:500;margin:0 0 6px;color:#1a1a1a}
.nesovi-col-card>p{font-size:13px;color:#666;margin:0 0 10px}
.nesovi-col-price{font-size:16px;font-weight:500;color:#1a1a1a;margin-bottom:14px}
.nesovi-col-card ul{list-style:none;padding:0;margin:0 0 18px}
.nesovi-col-card li{font-size:13px;color:#444;margin-bottom:6px}
.nesovi-col-cta{display:block;text-align:center;padding:11px;background:#5b6ef5;color:#fff;border-radius:8px;text-decoration:none;font-weight:500;font-size:14px}
.nesovi-col-cta:hover{background:#4a5ce0}
.nesovi-guarantee{max-width:900px;margin:28px auto 0;background:#fff8e1;border:1px solid #ffe082;border-radius:12px;padding:24px}
.nesovi-guarantee span{font-size:28px}
.nesovi-guarantee h3{font-size:16px;font-weight:500;margin:8px 0 6px;color:#1a1a1a}
.nesovi-guarantee p{font-size:13px;color:#555;margin:0}
@media(max-width:768px){.nesovi-col-grid{grid-template-columns:1fr}}
</style>
{% schema %}
{
  "name": "NESOVI Collections",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Two Ways to Wear NESOVI"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "All premium anti-tarnish. Choose what fits your style."},
    {"type": "text", "id": "guarantee_title", "label": "Guarantee title", "default": "Premium Anti-Tarnish Promise"},
    {"type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "Won't tarnish with daily wear. Tested & proven by 1000+ customers across all collections."}
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {"type": "text", "id": "badge", "label": "Badge", "default": "Daily Essentials"},
        {"type": "text", "id": "title", "label": "Title", "default": "Build Your Collection"},
        {"type": "text", "id": "description", "label": "Description", "default": "Premium jewelry to mix & match"},
        {"type": "text", "id": "price_range", "label": "Price range", "default": "₹149 – ₹799"},
        {"type": "text", "id": "features", "label": "Features (comma separated)", "default": "Premium anti-tarnish, Multiple pieces, Mix and match, Everyday to occasion"},
        {"type": "url", "id": "link", "label": "Link"},
        {"type": "text", "id": "button_label", "label": "Button label", "default": "Explore Collection"}
      ]
    }
  ],
  "presets": [{"name": "NESOVI Collections", "blocks": [{"type": "collection_card"}, {"type": "collection_card"}]}]
}
{% endschema %}