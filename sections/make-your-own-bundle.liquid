{% comment %}Flexi Box Bundle Functionality{% endcomment %}

{{ 'make-your-own-bundle-style.css' | asset_url | stylesheet_tag }}
<script src="{{ 'make-your-own-bundle-script.js' | asset_url }}" defer="defer"></script>

{%- assign flexi_box_bundle = product.metafields.custom.flexi_box_bundle.value -%}

<div class="flexi-box-bundle">
  <product-form class="sticky-cart__form">
    {%- form 'product', product,
      class: 'product__form',
      id: 'flexi-box-form',
      novalidate: 'novalidate',
      data-type: 'add-to-cart-form',
      data-variant-id: product.selected_or_first_available_variant.id,
      data-sku: product.selected_or_first_available_variant.sku,
      data-price: product.selected_or_first_available_variant.price
    -%}
      {% # Tab menu %}
      <div class="tab-menu sticky-header center">
        <div class="excluded-from-discount-combos">Save ₹30 with Prepaid Payment</div>
        <ul class="tab-items">
          {%- assign steps_count = flexi_box_bundle.count -%}
          {%- for flexi_box_step in flexi_box_bundle -%}
            <li class="tab-item">
              <div class="tab{% if forloop.first %} active-tab{% endif %}" data-id="tab{{ forloop.index }}">
                <div class="sticky-header-bubble">
                  <h5 class="step-heading">{% if steps_count > 1 %}STEP {{ forloop.index }}{% else %}{{ product.title }}{% endif %}</h5>
                  <div class="bubble-wrapper">
                    <span class="bubble-counter" id="checkbox_count_tab_{{ forloop.index }}_product"></span>
                  </div>
                  {% if forloop.index == 1 %}
                    <p class="collection-label">2 Necklace 📿</p>
                  {% elsif forloop.index == 2 %}
                    <p class="collection-label">2 Earrings 💍</p>
                  {% elsif forloop.index == 3 %}
                    <p class="collection-label">2 Bracelet ✨</p>
                  {% endif %}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div id="scroll-to-reviews" class="nesovi-badge">
          🔒 Secure Checkout | 💯 Skin Safe | ⭐ Loved by 1000+ Customers
        </div>
      </div>
      {% # end of tab-menu %}
      <script>
        let totalproductSelection = 0;
      </script>
      <hr class="hr-divider" style="margin:0 0 10px;">
      {% # Custom search bar code %}
      <div class="search center hidden">
        <input
          id="searchbar"
          type="text"
          class="search-field"
          name="search"
          placeholder="Search..."
          onkeypress="return event.keyCode != 13;"
        >
        <span class="search-clear">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
            <path d="M12.0007 10.5865L16.9504 5.63672L18.3646 7.05093L13.4149 12.0007L18.3646 16.9504L16.9504 18.3646L12.0007 13.4149L7.05093 18.3646L5.63672 16.9504L10.5865 12.0007L5.63672 7.05093L7.05093 5.63672L12.0007 10.5865Z" fill="rgba(191,191,191,1)"></path>
          </svg>
        </span>
      </div>
      {% # Custom search bar code Ends %}
      {%- assign item_index = 0 -%}
      {%- for flexi_box_step in flexi_box_bundle -%}
        {%- assign tab_index = forloop.index -%}
        <script>
          totalproductSelection = totalproductSelection + Number({{ flexi_box_step.mandatory_products }});
        </script>

        <div
          class="tab-content{% if forloop.first %} active-tab-content{% endif %}"
          data-product-limit="{{ flexi_box_step.mandatory_products }}"
          data-id="tab{{ tab_index }}"
        >
          {%- assign flexi_box_collection = flexi_box_step.collection.value -%}
          {%- assign variant_ids = '' -%}
          {%- assign product_variant_gids = flexi_box_collection.metafields.custom.flexi_box_variant_sort_order.value -%}

          <ul id="collection-list" style="margin-top: 95px;">
            <div class="row collection page-width">
              {%- assign product_limit = flexi_box_step.display_products -%}
              {%- assign product_index = 0 -%}

              {%- if product_variant_gids != blank -%}
                {%- for product_variant in product_variant_gids -%}
                  {%- for product_flexi in flexi_box_collection.products -%}
                    {%- for variant in product_flexi.variants -%}
                      {%- if variant.id == product_variant.id -%}
                        {%- assign product_index = product_index | plus: 1 -%}
                        {%- if product_limit >= product_index -%}
                          {% assign item_index = item_index | plus: 1 %}
                          {%- render 'make-your-own-bundle',
                            product_flexi: product_flexi,
                            variant: variant,
                            product: product,
                            tab_index: tab_index,
                            product_index: product_index,
                            item_index: item_index
                          -%}
                        {% endif %}
                        {% assign variant_ids = variant_ids | append: variant.id | append: ',' %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                {% endfor %}
              {% endif %}

              {%- for product_flexi in flexi_box_collection.products -%}
                {%- for variant in product_flexi.variants -%}
                  {%- unless variant_ids contains variant.id -%}
                    {%- assign product_index = product_index | plus: 1 -%}
                    {%- if product_limit >= product_index -%}
                      {% assign item_index = item_index | plus: 1 %}
                      {%- render 'make-your-own-bundle-item',
                        product_flexi: product_flexi,
                        variant: variant,
                        product: product,
                        tab_index: tab_index,
                        product_index: product_index,
                        item_index: item_index
                      -%}
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </ul>
        </div>
        {% # End of tab %}
      {%- endfor -%}

      <div class="sticky_cart">
        <div class="product-details page-width">
          <div class="prd-details prd-details-left">
            <div class="prd-image-title">
              {{ product.featured_image | image_url: width: 150 | image_tag: loading: 'lazy', fetchpriority: 'low', class: 'featured-img' }}
              <h3>{{ product.title }}</h3>
            </div>
          </div>
          <div class="prd-details prd-details-right">
            <div class="prd-image-price-cart">
              <div class="prd-price">Total: {{ product.price | money | remove: '.00' }}/-</div>
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                id="submit-btn"
                name="add"
                class="flex--box-ATC-btn btn btn--large btn--submit product__submit__add"
                style="display: inline-block; pointer-events: none; background-color: #ddd;"
                {%- if product.selected_or_first_available_variant.available == false %}
                  disabled="disabled"
                {% endif -%}
                data-add-to-cart
              >
                {%- liquid
                  if product.selected_or_first_available_variant.available
                    echo 'products.product.add_to_cart' | t
                  else
                    echo 'products.product.sold_out' | t
                  endif
                -%}
                <em class="loader loader--line"><em class="loader-indeterminate"></em></em>
              </button>
            </div>
          </div>
        </div>
      </div>
    {%- endform -%}
  </product-form>
</div>
{% # end of container %}

{% # Flexi Box Bundle Item Popup %}
{%- render 'make-your-own-bundle-item-popup' -%}

<div class="message-bar is-hidden">
  <div class="message message--green">
    <div class="message-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="9" viewBox="0 0 11 9" fill="none">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.66802 1.37429L4.48642 7.85309L0.416016 4.46069L1.18402 3.53909L4.31362 6.14669L8.73201 0.625488L9.66802 1.37429Z" fill="#000" stroke="#000" stroke-width="0.5"/>
      </svg>
    </div>
    <div class="message-body">
      <p>
        <span></span>
        added to box
      </p>
    </div>
  </div>
</div>

{% comment %} Script to highlight bundle product added to box {% endcomment %}
<style>
  .nesovi-badge {
    cursor: pointer;
    font-weight: 600;
    text-align: center;
    margin: 10px 0;
  }
  .nesovi-badge:hover {
    text-decoration: underline;
  }
</style>
<script>
  const addToBoxBtns = document.querySelectorAll(".add-to-box");

  function checkIfAddedToBox(e){
    const parentElement = e.target.closest(".collection-item");
    const elementToCheck = parentElement.querySelector(".added_to_cart");
    const elementToBeHighlighted = parentElement.querySelector(".slider-wrapper");
    
    if(elementToCheck.classList.contains("_hidden")){
      elementToBeHighlighted.classList.remove("flexi-box-product-highlight");
    }else{
      elementToBeHighlighted.classList.add("flexi-box-product-highlight");
    }
  }

  if(addToBoxBtns && addToBoxBtns.length > 0){
    for(let i=0; i<addToBoxBtns.length; i++){
      addToBoxBtns[i].addEventListener("click", checkIfAddedToBox);
    }
  }

  document.getElementById('scroll-to-reviews').addEventListener('click', function() {
    const reviewSection = document.querySelector('.jdgm-horizon-widget');
    if (reviewSection) {
      reviewSection.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>

{% comment %} end - Script to highlight bundle product added to box {% endcomment %}

{%- schema -%}
{
  "name": "Flexi box bundle",
  "settings": [],
  "presets": [
    {
      "name": "Flexi box bundle"
    }
  ]
}
{%- endschema -%}
