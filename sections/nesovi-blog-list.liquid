<section class="nesovi-blog">
  <h1>{{ section.settings.heading | default: blog.title }}</h1>
  <p class="nesovi-blog-sub">{{ section.settings.subheading }}</p>
  <div class="nesovi-blog-grid">
    {% paginate blog.articles by section.settings.per_page %}
      {% for article in blog.articles %}
        <a href="{{ article.url }}" class="nesovi-blog-card">
          <div class="nesovi-blog-img">
            {% if article.image %}<img src="{{ article.image | image_url: width: 720 }}" alt="{{ article.title | escape }}" loading="lazy">{% else %}<div class="nesovi-blog-ph">💎</div>{% endif %}
          </div>
          <div class="nesovi-blog-content">
            {% if article.tags.size > 0 %}<span class="nesovi-blog-cat">{{ article.tags.first }}</span>{% endif %}
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
            <div class="nesovi-blog-meta">{{ article.published_at | date: '%b %d, %Y' }} · <span>Read more →</span></div>
          </div>
        </a>
      {% endfor %}
      <div class="nesovi-blog-pag">{{ paginate | default_pagination }}</div>
    {% endpaginate %}
  </div>
</section>
<style>
.nesovi-blog{padding:48px 24px;background:#fafaf9;max-width:1000px;margin:0 auto}
.nesovi-blog h1{font-size:28px;font-weight:500;text-align:center;margin:0 0 8px;color:#1a1a1a}
.nesovi-blog-sub{text-align:center;font-size:14px;color:#666;margin:0 0 32px}
.nesovi-blog-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.nesovi-blog-card{background:#fff;border:1px solid #e0e0e0;border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s}
.nesovi-blog-card:hover{border-color:#999;box-shadow:0 4px 14px rgba(0,0,0,.08)}
.nesovi-blog-img{aspect-ratio:16/9;background:#f0f0f0}
.nesovi-blog-img img{width:100%;height:100%;object-fit:cover}
.nesovi-blog-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:40px;background:linear-gradient(135deg,#f0f7ff,#f3f0ff)}
.nesovi-blog-content{padding:18px 20px}
.nesovi-blog-cat{font-size:11px;color:#5b6ef5;font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.nesovi-blog-content h3{font-size:16px;font-weight:500;margin:8px 0;line-height:1.4;color:#1a1a1a}
.nesovi-blog-content p{font-size:13px;color:#666;line-height:1.6;margin:0 0 12px}
.nesovi-blog-meta{font-size:12px;color:#999}
.nesovi-blog-meta span{color:#5b6ef5;font-weight:500}
.nesovi-blog-pag{grid-column:1/-1;text-align:center;margin-top:12px}
@media(max-width:768px){.nesovi-blog-grid{grid-template-columns:1fr}}
</style>
{% schema %}
{
  "name": "NESOVI Blog List",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "NESOVI Stories"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Learn why anti-tarnish jewelry matters. Real stories from real customers."},
    {"type": "range", "id": "per_page", "label": "Posts per page", "min": 2, "max": 24, "step": 2, "default": 8}
  ]
}
{% endschema %}