{%- doc -%}
  "Make your own bundle" — grid variant.

  Same data source and cart payload contract as the step-wise
  `make-your-own-bundle` section (product metafield
  `custom.flexi_box_bundle`), but rendered as one flat grid with collection
  filter pills and a single global "pick N" limit instead of a step wizard.
  The number of products a customer must pick is the SUM of
  `mandatory_products` across all metafield entries, so the wizard's 1+1+1
  setup naturally becomes "pick any 3" here.

  Both sections read the same metafields and can run side by side on
  different product templates.
{%- enddoc -%}

{% comment %}
  Reuses the step-wise bundle's info-popup and image-slider snippets (and
  therefore their styles) — see the snippet include below and
  make-your-own-bundle-grid-item.liquid.
{% endcomment %}
{{ 'make-your-own-bundle.css' | asset_url | stylesheet_tag }}
{{ 'make-your-own-bundle-grid.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'make-your-own-bundle-grid.js' | asset_url }}"
  type="module"
></script>

{%- liquid
  assign flexi_box_bundle = product.metafields.custom.flexi_box_bundle.value

  assign required_total = 0
  for flexi_box_step in flexi_box_bundle
    assign required_total = required_total | plus: flexi_box_step.mandatory_products
  endfor
  if required_total == 0
    assign required_total = 3
  endif

  assign selected_variant = product.selected_or_first_available_variant
  assign bundle_grid_form_id = 'BundleGridForm-' | append: section.id
-%}

{%- if flexi_box_bundle == blank -%}
  {%- if request.design_mode -%}
    <div class="bundle-grid__empty page-width">
      This product has no <code>custom.flexi_box_bundle</code> metafield set. Add the
      bundle collections to the product metafield to populate this section.
    </div>
  {%- endif -%}
{%- else -%}

  {% comment %}
    Pass 1 — build one "|handle|handle|handle" string per bundle collection so
    we can work out, at render time, every filter a product belongs to. The
    strings are joined with a delimiter and split back into an array, which is
    the only way to keep a list-of-lists in Liquid.
  {% endcomment %}
  {%- liquid
    assign cat_lists = ''
    for flexi_box_step in flexi_box_bundle
      assign one = '|'
      for cat_product in flexi_box_step.collection.value.products
        assign one = one | append: cat_product.handle | append: '|'
      endfor
      assign cat_lists = cat_lists | append: one | append: '<<>>'
    endfor
    assign cat_lists = cat_lists | split: '<<>>'
  -%}

  <bundle-grid-component
    id="BundleGrid-{{ section.id }}"
    class="bundle-grid"
    data-variant-id="{{ selected_variant.id }}"
    data-sku="{{ selected_variant.sku }}"
    data-price="{{ selected_variant.price }}"
    data-currency="{{ localization.country.currency.iso_code }}"
    data-required-total="{{ required_total }}"
    on:submit="/handleSubmit"
  >
    <template ref="moneyFormat">{{ shop.money_format }}</template>

    {%- form 'product', product, id: bundle_grid_form_id, data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        value="{{ selected_variant.id }}"
      >

      <div class="bundle-grid__head page-width">
        {%- if section.settings.note != blank -%}
          <div class="bundle-grid__note">{{ section.settings.note }}</div>
        {%- endif -%}

        <h1 class="bundle-grid__heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>

        {%- if section.settings.show_search -%}
          <div class="bundle-grid__search">
            <label class="visually-hidden" for="BundleGridSearch-{{ section.id }}">Search</label>
            <input
              type="text"
              id="BundleGridSearch-{{ section.id }}"
              class="bundle-grid__search-input"
              ref="searchInput"
              placeholder="{{ section.settings.search_placeholder | default: 'Search products...' }}"
              on:input="/handleSearchInput"
            >
            <button
              type="button"
              class="bundle-grid__search-clear"
              aria-label="{{ 'actions.clear' | t }}"
              on:click="/handleSearchClear"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>
        {%- endif -%}

        {% comment %} Filter pills — "All" plus one per bundle collection {% endcomment %}
        <div class="bundle-grid__filters" role="tablist" aria-label="Filter products">
          <button
            type="button"
            class="bundle-grid__pill bundle-grid__pill--active"
            data-cat="all"
            role="tab"
            aria-selected="true"
            ref="pills[]"
            on:click="/handlePillClick"
          >
            {{ section.settings.all_label | default: 'All' }}
          </button>
          {%- for flexi_box_step in flexi_box_bundle -%}
            {%- assign step_collection = flexi_box_step.collection.value -%}
            {%- if step_collection != blank -%}
              {% comment %}
                The bundle collections are named for the step wizard ("Step 1",
                "Step 2"...), which reads wrong as a filter. Set
                `custom.bundle_filter_label` on the collection to override the
                pill text without renaming the collection itself.
              {% endcomment %}
              {%- assign pill_label = step_collection.metafields.custom.bundle_filter_label.value | default: step_collection.title -%}
              <button
                type="button"
                class="bundle-grid__pill"
                data-cat="{{ forloop.index }}"
                role="tab"
                aria-selected="false"
                ref="pills[]"
                on:click="/handlePillClick"
              >
                {{ pill_label }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {% comment %}
        Pass 2 — one flat, de-duplicated grid. A product that sits in more
        than one bundle collection is rendered once and tagged with every
        filter it belongs to.
      {% endcomment %}
      {%- liquid
        assign mobile_layout = section.settings.mobile_layout | default: 'carousel'
        assign desktop_columns = section.settings.desktop_columns | default: 4
      -%}
      <ul
        class="bundle-grid__grid bundle-grid__grid--{{ mobile_layout }} page-width"
        style="--bundle-grid-cols: {{ desktop_columns }};"
      >
        {%- liquid
          assign seen = '|'
          assign item_index = 0
        -%}

        {%- for flexi_box_step in flexi_box_bundle -%}
          {%- assign step_collection = flexi_box_step.collection.value -%}
          {%- assign product_limit = flexi_box_step.display_products -%}
          {%- assign shown = 0 -%}

          {% comment %} Curated order first, if the collection defines one {% endcomment %}
          {%- assign sort_order = step_collection.metafields.custom.flexi_box_variant_sort_order.value -%}
          {%- if sort_order != blank -%}
            {%- for sorted_variant in sort_order -%}
              {%- for item_product in step_collection.products -%}
                {%- for item_variant in item_product.variants -%}
                  {%- if item_variant.id == sorted_variant.id -%}
                    {%- assign key = '|' | append: item_variant.id | append: '|' -%}
                    {%- unless seen contains key -%}
                      {%- if product_limit == blank or shown < product_limit -%}
                        {%- liquid
                          assign seen = seen | append: item_variant.id | append: '|'
                          assign shown = shown | plus: 1
                          assign item_index = item_index | plus: 1

                          assign cats = ''
                          for cat_list in cat_lists
                            assign needle = '|' | append: item_product.handle | append: '|'
                            if cat_list contains needle
                              assign cats = cats | append: forloop.index | append: ' '
                            endif
                          endfor
                        -%}
                        {%- render 'make-your-own-bundle-grid-item',
                          product_flexi: item_product,
                          variant: item_variant,
                          cats: cats,
                          item_index: item_index
                        -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}

          {% comment %} Then everything else in the collection {% endcomment %}
          {%- for item_product in step_collection.products -%}
            {%- for item_variant in item_product.variants -%}
              {%- assign key = '|' | append: item_variant.id | append: '|' -%}
              {%- unless seen contains key -%}
                {%- if product_limit == blank or shown < product_limit -%}
                  {%- liquid
                    assign seen = seen | append: item_variant.id | append: '|'
                    assign shown = shown | plus: 1
                    assign item_index = item_index | plus: 1

                    assign cats = ''
                    for cat_list in cat_lists
                      assign needle = '|' | append: item_product.handle | append: '|'
                      if cat_list contains needle
                        assign cats = cats | append: forloop.index | append: ' '
                      endif
                    endfor
                  -%}
                  {%- render 'make-your-own-bundle-grid-item',
                    product_flexi: item_product,
                    variant: item_variant,
                    cats: cats,
                    item_index: item_index
                  -%}
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>

      <p class="bundle-grid__no-results" ref="noResults" hidden>
        {{ section.settings.no_results_label | default: 'No products match your search.' }}
      </p>

      {% comment %} Sticky selection tray {% endcomment %}
      <div class="bundle-grid__tray" ref="tray" data-state="empty">
        <div class="bundle-grid__tray-inner page-width">
          <div class="bundle-grid__tray-left" on:click="/openSheet">
            <div class="bundle-grid__tray-slots">
              {%- for i in (1..required_total) -%}
                <div class="bundle-grid__tray-slot" ref="traySlots[]">
                  <span class="bundle-grid__tray-slot-plus" aria-hidden="true">+</span>
                </div>
              {%- endfor -%}
            </div>
            <div class="bundle-grid__tray-copy">
              <p class="bundle-grid__tray-count">
                <span ref="trayCountCurrent">0</span>/<span>{{ required_total }}</span> Added
              </p>
              <p
                class="bundle-grid__tray-hint"
                ref="trayHint"
                data-unlock-singular="{{ section.settings.unlock_singular | default: 'Add 1 More To Unlock' }}"
                data-unlock-plural="{{ section.settings.unlock_plural | default: 'Add [n] More To Unlock' }}"
                data-unlock-done="{{ section.settings.unlock_done | default: 'Your box is ready!' }}"
                data-unlock-price="{{ product.price | money_without_trailing_zeros }}"
              ></p>
            </div>
          </div>

          <div class="bundle-grid__tray-right">
            <div class="bundle-grid__tray-price">
              <span class="bundle-grid__tray-price-label">{{ section.settings.price_label | default: 'Deal Price:' }}</span>
              <span class="bundle-grid__tray-price-amounts">
                <span>{{ product.price | money_without_trailing_zeros }}</span>
                <s class="bundle-grid__tray-price-compare" ref="trayPriceCompare" hidden></s>
              </span>
            </div>
            <button
              type="submit"
              class="bundle-grid__tray-atc"
              ref="submitButton"
              data-available="{{ selected_variant.available }}"
              disabled
            >
              {%- if selected_variant.available -%}
                {{ 'actions.add_to_cart' | t }}
              {%- else -%}
                {{ 'blocks.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>

          <button
            type="button"
            class="bundle-grid__tray-expand"
            aria-label="View your box"
            aria-expanded="false"
            on:click="/openSheet"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        {% comment %}
          "Your Box" panel. It lives INSIDE the tray so the floating card
          simply grows upward when opened, rather than a separate sheet
          sliding over the page — the tray's own inner row is hidden while it
          is open.
        {% endcomment %}
        <div
          class="bundle-grid__sheet"
          ref="sheet"
          hidden
          role="dialog"
          aria-modal="true"
          aria-labelledby="BundleGridSheetTitle-{{ section.id }}"
          data-remove-label="{{ section.settings.remove_label | default: 'Remove' | escape }}"
          data-saved-label="{{ section.settings.saved_label | default: 'You saved [amount]' | escape }}"
          data-placeholder-label="{{ section.settings.placeholder_label | default: 'Product' | escape }}"
          data-bundle-price="{{ product.price }}"
        >
          <div class="bundle-grid__sheet-head">
            <h2 class="bundle-grid__sheet-title" id="BundleGridSheetTitle-{{ section.id }}">
              {{ section.settings.sheet_title | default: 'Your Box' }}
              (<span ref="sheetCount">0</span>/{{ required_total }})
            </h2>
            <button
              type="button"
              class="bundle-grid__sheet-close"
              aria-label="{{ 'actions.close' | t }}"
              on:click="/closeSheet"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>

          <div class="bundle-grid__sheet-body">
            <ul class="bundle-grid__sheet-items" ref="sheetItems"></ul>

            <p class="bundle-grid__sheet-empty" ref="sheetEmpty" hidden>
              {{ section.settings.sheet_empty | default: 'Your box is empty. Add products to get started.' }}
            </p>

            <div class="bundle-grid__sheet-bill" ref="sheetBill" hidden>
              <div class="bundle-grid__sheet-bill-head">
                <span class="bundle-grid__sheet-bill-title">{{ section.settings.bill_title | default: 'Bill Summary' }}</span>
                <span class="bundle-grid__sheet-saved" ref="sheetSaved" hidden></span>
              </div>
              <dl class="bundle-grid__sheet-bill-rows">
                <div class="bundle-grid__sheet-bill-row">
                  <dt>
                    {{ section.settings.subtotal_label | default: 'Subtotal' }}
                    (<span ref="sheetBillCount">0</span> <span ref="sheetBillUnit">items</span>)
                  </dt>
                  <dd ref="sheetSubtotal"></dd>
                </div>
                <div class="bundle-grid__sheet-bill-row bundle-grid__sheet-bill-row--discount" ref="sheetDiscountRow" hidden>
                  <dt>{{ section.settings.discount_label | default: 'Bundle Discount' }}</dt>
                  <dd ref="sheetDiscount"></dd>
                </div>
                <div class="bundle-grid__sheet-bill-row bundle-grid__sheet-bill-row--total">
                  <dt>{{ section.settings.total_label | default: 'Total' }}</dt>
                  <dd ref="sheetTotal"></dd>
                </div>
              </dl>
            </div>
          </div>

          <div class="bundle-grid__sheet-foot">
            <div class="bundle-grid__tray-price">
              <span class="bundle-grid__tray-price-label">{{ section.settings.price_label | default: 'Deal Price:' }}</span>
              <span class="bundle-grid__tray-price-amounts">
                <span>{{ product.price | money_without_trailing_zeros }}</span>
                <s class="bundle-grid__tray-price-compare" ref="sheetPriceCompare" hidden></s>
              </span>
            </div>
            {% comment %}
              Proxy button — the real submit lives in the tray, and two
              elements with the same id inside one form would be invalid.
            {% endcomment %}
            <button type="button" class="bundle-grid__tray-atc" ref="sheetSubmitButton" on:click="/handleSubmit" disabled>
              {{ 'actions.add_to_cart' | t }}
            </button>
          </div>
        </div>
      </div>

      {% comment %}
        Backdrop is a sibling of the tray, not a child: the tray is
        transform-centred on desktop, and a transformed ancestor becomes the
        containing block for fixed children, which would trap it inside the
        card.
      {% endcomment %}
      <div class="bundle-grid__sheet-backdrop" ref="sheetBackdrop" on:click="/closeSheet" hidden></div>
    {%- endform -%}

    {%- render 'make-your-own-bundle-item-popup' -%}

    <div class="bundle-grid__toast" ref="toast">
      <span ref="toastText"></span> added to box
    </div>
  </bundle-grid-component>
{%- endif -%}

{% schema %}
{
  "name": "Make your own bundle (grid)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note above heading"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All\" filter label",
      "default": "All"
    },
    {
      "type": "header",
      "content": "Product layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "info": "Carousel shows one swipeable row. Grid stacks products two per row.",
      "options": [
        { "value": "carousel", "label": "Carousel (swipe sideways)" },
        { "value": "grid", "label": "Grid (2 per row)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Products per row on desktop",
      "info": "Applies on wide screens. Tablets always show 3 per row.",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Selection tray"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Deal Price:"
    },
    {
      "type": "text",
      "id": "unlock_singular",
      "label": "Hint — 1 remaining",
      "default": "Add 1 More To Unlock"
    },
    {
      "type": "text",
      "id": "unlock_plural",
      "label": "Hint — more than 1 remaining",
      "info": "Use [n] for the number remaining.",
      "default": "Add [n] More To Unlock"
    },
    {
      "type": "text",
      "id": "unlock_done",
      "label": "Hint — box complete",
      "info": "Use [price] for the bundle price.",
      "default": "You've Unlocked [price] Deal Price"
    },
    {
      "type": "header",
      "content": "\"Your Box\" sheet"
    },
    {
      "type": "text",
      "id": "sheet_title",
      "label": "Sheet title",
      "default": "Your Box"
    },
    {
      "type": "text",
      "id": "sheet_empty",
      "label": "Empty state text",
      "default": "Your box is empty. Add products to get started."
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove link text",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Empty slot label",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "bill_title",
      "label": "Bill summary heading",
      "default": "Bill Summary"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "default": "Bundle Discount"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "saved_label",
      "label": "Savings badge",
      "info": "Use [amount] for the amount saved.",
      "default": "You saved [amount]"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": false
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products..."
    },
    {
      "type": "text",
      "id": "no_results_label",
      "label": "No results text",
      "default": "No products match your search."
    }
  ],
  "presets": [
    {
      "name": "Make your own bundle (grid)"
    }
  ]
}
{% endschema %}
