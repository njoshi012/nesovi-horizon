<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div class="why-choose-section color-{{ section.settings.color_scheme }} spacing-style{% if section.settings.image_position == 'right' %} why-choose-section--reversed{% endif %}" style="{% render 'spacing-style', settings: section.settings %}">

  <div class="why-choose-section__image">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag:
          class: 'why-choose-section__img',
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          alt: section.settings.image.alt | default: section.settings.heading
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'why-choose-section__img why-choose-section__img--placeholder' }}
    {%- endif -%}
  </div>

  <div class="why-choose-section__body">

    {%- if section.settings.eyebrow != blank -%}
      <p class="why-choose-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="why-choose-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="why-choose-section__description">{{ section.settings.description | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="why-choose-section__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <li class="why-choose-section__item" {{ block.shopify_attributes }}>
              <span class="why-choose-section__check" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="11" cy="11" r="10.5" stroke="currentColor" stroke-opacity="0.2"/>
                  <path d="M6.5 11L9.5 14L15.5 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="why-choose-section__label">{{ block.settings.label | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="button why-choose-section__btn"
      >
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}

  </div>

</div>

{% stylesheet %}
  .why-choose-section {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .why-choose-section {
      grid-template-columns: 1fr 1fr;
      min-height: 500px;
    }
    .why-choose-section--reversed .why-choose-section__image { order: 2; }
    .why-choose-section--reversed .why-choose-section__body  { order: 1; }
  }

  .why-choose-section__image {
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }

  .why-choose-section__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .why-choose-section__img--placeholder {
    width: 100%;
    min-height: 280px;
    background: #f0f0f0;
  }

  .why-choose-section__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 24px;
  }

  @media screen and (min-width: 750px) {
    .why-choose-section__body {
      padding: 56px 52px;
    }
  }

  .why-choose-section__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.55;
    margin: 0 0 14px;
    line-height: 1;
  }

  .why-choose-section__heading {
    font-size: 24px;
    font-weight: 600;
    text-transform: capitalize;
    line-height: 1.2;
    color: var(--color-foreground-heading);
    margin: 0 0 16px;
  }

  .why-choose-section__description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-foreground);
    opacity: 0.75;
    margin: 0 0 28px;
  }

  .why-choose-section__list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .why-choose-section__item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .why-choose-section__check {
    display: flex;
    flex-shrink: 0;
    color: var(--color-foreground-heading);
  }

  .why-choose-section__label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.4;
  }

  .why-choose-section__btn {
    align-self: flex-start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side",
      "options": [
        { "value": "left",  "label": "Left"  },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (optional)"
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "category": "Promotional",
      "blocks": {
        "p1": { "type": "point", "settings": { "label": "Premium AD Stones" } },
        "p2": { "type": "point", "settings": { "label": "Anti-Tarnish Technology" } },
        "p3": { "type": "point", "settings": { "label": "Lightweight Comfort" } },
        "p4": { "type": "point", "settings": { "label": "Wedding & Party Ready" } },
        "p5": { "type": "point", "settings": { "label": "Crafted To Last" } }
      },
      "block_order": ["p1","p2","p3","p4","p5"],
      "settings": {
        "eyebrow": "Why Choose Nesovi",
        "heading": "Luxury Jewellery Designed For Everyday Glamour",
        "image_position": "left"
      }
    }
  ]
}
{% endschema %}
