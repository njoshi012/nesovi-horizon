<section class="nesovi-up" data-pid="{{ product.id }}" data-limit="{{ section.settings.limit }}" data-source="{{ section.settings.source }}">
  <h2>{{ section.settings.heading }}</h2>
  <p class="nesovi-up-sub">{{ section.settings.subheading }}</p>
  <div class="nesovi-up-grid">
    {% if section.settings.source == 'manual' %}
      {% for block in section.blocks %}
        {% assign mp = block.settings.product %}
        {% if mp != blank %}
          <a href="{{ mp.url }}" class="nesovi-up-card" {{ block.shopify_attributes }}>
            {% if mp.featured_image %}<img src="{{ mp.featured_image | image_url: width: 480 }}" alt="{{ mp.title | escape }}" loading="lazy">{% endif %}
            <h3>{{ mp.title }}</h3>
            <p>{{ mp.price | money }}</p>
          </a>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>
{% stylesheet %}
.nesovi-up{padding:40px 24px;text-align:center;max-width:1000px;margin:0 auto}
.nesovi-up h2{font-size:24px;font-weight:600;text-transform:capitalize;margin:0 0 6px;color:#1a1a1a}
.nesovi-up-sub{font-size:13px;color:#666;margin:0 0 24px}
.nesovi-up-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.nesovi-up-card{background:#fff;border:1px solid #e0e0e0;border-radius:10px;overflow:hidden;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s}
.nesovi-up-card:hover{border-color:#5b6ef5;box-shadow:0 4px 14px rgba(91,110,245,.12)}
.nesovi-up-card img{width:100%;aspect-ratio:1;object-fit:cover;display:block;background:#f5f5f5}
.nesovi-up-card h3{font-size:12px;font-weight:500;margin:10px 10px 4px;color:#1a1a1a;text-align:left}
.nesovi-up-card p{font-size:12px;color:#666;margin:0 10px 10px;text-align:left}
@media(max-width:768px){.nesovi-up-grid{grid-template-columns:repeat(2,1fr)}}
{% endstylesheet %}
{% javascript %}
(function(){
  document.querySelectorAll('.nesovi-up').forEach(function(sec){
    if(sec.dataset.nesoviInit||sec.dataset.source==='manual')return;sec.dataset.nesoviInit='1';
    var g=sec.querySelector('.nesovi-up-grid'),pid=sec.dataset.pid,limit=sec.dataset.limit;
    if(!pid)return;
    fetch('/recommendations/products.json?product_id='+pid+'&limit='+limit+'&intent='+(sec.dataset.source==='related'?'related':'complementary'))
      .then(function(r){return r.json()})
      .then(function(d){
        if(!d.products||!d.products.length){sec.style.display='none';return;}
        g.innerHTML=d.products.map(function(p){
          var img=p.featured_image?p.featured_image.replace(/(\.[a-z]+)(\?|$)/,'_480x$1$2'):'';
          return '<a href="'+p.url+'" class="nesovi-up-card"><img src="'+img+'" alt="" loading="lazy"><h3>'+p.title+'</h3><p>\u20b9'+(p.price/100).toFixed(0)+'</p></a>';
        }).join('');
      }).catch(function(){sec.style.display='none';});
  });
})();
{% endjavascript %}
{% schema %}
{
  "name": "NESOVI Cross-sell",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "💍 Upgrade Your Look"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Pairs beautifully with signature pieces."},
    {"type": "select", "id": "source", "label": "Product source", "options": [{"value": "complementary", "label": "Auto (Shopify complementary)"}, {"value": "related", "label": "Auto (Shopify related/similar)"}, {"value": "manual", "label": "Manual picks"}], "default": "complementary"},
    {"type": "range", "id": "limit", "label": "Products (auto mode)", "min": 2, "max": 8, "step": 1, "default": 4}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"}
      ]
    }
  ],
  "presets": [{"name": "NESOVI Cross-sell"}]
}
{% endschema %}