

{%- liquid
  assign block_settings = block.settings
  assign items = ''
-%}

<div class="pdp-trust-badges spacing-style" style="{% render 'spacing-style', settings: block_settings %}" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- liquid
      case i
        when 1
          assign item_icon = block_settings.icon_1
          assign item_text = block_settings.text_1
        when 2
          assign item_icon = block_settings.icon_2
          assign item_text = block_settings.text_2
        when 3
          assign item_icon = block_settings.icon_3
          assign item_text = block_settings.text_3
        when 4
          assign item_icon = block_settings.icon_4
          assign item_text = block_settings.text_4
      endcase
    -%}
    {%- if item_text != blank -%}
      <div class="pdp-trust-badges__item">
        <svg class="pdp-trust-badges__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case item_icon -%}
            {%- when 'shield' -%}
              <path d="M12 3.5 19 6.5V11c0 4.8-3 8.6-7 9.9-4-1.3-7-5.1-7-9.9V6.5L12 3.5Z" />
              <path d="m9 12 2 2 4-4" />
            {%- when 'droplet' -%}
              <path d="M12 3.3s6.2 6.6 6.2 10.7A6.2 6.2 0 0 1 5.8 14C5.8 9.9 12 3.3 12 3.3Z" />
            {%- when 'leaf' -%}
              <path d="M4.5 19.5c8 0 13.5-5.8 14-14.5-9.5.5-15 6-15 14.5Z" />
              <path d="M4.5 19.5 14 10" />
            {%- when 'diamond' -%}
              <path d="M3 8.5 7.5 3h9l4.5 5.5L12 21 3 8.5Z" />
              <path d="M3 8.5h18" />
              <path d="m8.5 3 3.5 5.5-1 12.5" />
              <path d="m15.5 3-3.5 5.5" />
          {%- endcase -%}
        </svg>
        <span class="pdp-trust-badges__text">{{ item_text }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .pdp-trust-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm, 0.7rem);
    padding: var(--padding-sm, 0.7rem) var(--padding-sm, 0.7rem);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-md, 0.8rem);
    background: #eee2de;
  }

  .pdp-trust-badges__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-3xs, 0.125rem);
    flex: 1 1 0;
    min-width: 4.5rem;
    text-align: center;
  }

  .pdp-trust-badges__icon {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--color-primary);
  }

  .pdp-trust-badges__text {
    font-size: var(--font-size--xs, 0.8125rem);
    color: var(--color-foreground);
  }
{% endstylesheet %}

