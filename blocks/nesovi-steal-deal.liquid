{% assign collection_handle = block.settings.collection %}
{% assign tag = block.settings.tag %}
<div class="nesovi-steal" {{ block.shopify_attributes }}>
  <h4 class="nesovi-steal-title">{{ block.settings.heading }} {{ block.settings.emoji }}</h4>
  <div class="nesovi-steal-row">
    {% assign count = 0 %}
    {% if collection_handle != blank %}
      {% assign col = collections[collection_handle] %}
      {% for p in col.products %}
        {% if tag == blank or p.tags contains tag %}
          {% if count < block.settings.limit %}
            {% assign count = count | plus: 1 %}
            {% render 'nesovi-steal-card', p: p %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div>
{% stylesheet %}
.nesovi-steal{background:#eaf6ff;border-radius:12px;padding:14px;margin:12px 0}
.nesovi-steal-title{font-size:14px;font-weight:600;margin:0 0 10px;color:#1a1a1a}
.nesovi-steal-row{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px}
.nesovi-steal-row::-webkit-scrollbar{display:none}
.nesovi-steal-card{flex:0 0 124px;background:#fff;border-radius:10px;overflow:hidden;text-decoration:none;color:inherit;position:relative;display:flex;flex-direction:column}
.nesovi-steal-badge{position:absolute;top:8px;left:-4px;background:#f4452f;color:#fff;font-size:10px;font-weight:600;padding:3px 10px 3px 12px;border-radius:0 4px 4px 0;z-index:1}
.nesovi-steal-badge:after{content:'';position:absolute;left:0;top:100%;border:4px solid transparent;border-top-color:#a52f1f;border-left-color:#a52f1f}
.nesovi-steal-card img{width:100%;aspect-ratio:1;object-fit:cover;background:#f5f5f5}
.nesovi-steal-card .nsc-info{padding:8px}
.nesovi-steal-card h5{font-size:11px;font-weight:500;margin:0 0 4px;color:#1a1a1a;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3;height:2.6em}
.nesovi-steal-card .nsc-price{font-size:12px;color:#1a1a1a;margin:0 0 8px}
.nesovi-steal-card .nsc-price s{color:#999;font-weight:400;margin-left:4px;font-size:11px}
.nesovi-steal-grab{display:block;width:100%;border:none;background:#1a1a1a;color:#fff;font-size:11px;font-weight:700;letter-spacing:.5px;padding:8px 0;text-transform:uppercase;cursor:pointer;border-radius:0 0 10px 10px;margin-top:auto}
.nesovi-steal-grab:disabled{background:#666}
{% endstylesheet %}
{% javascript %}
(function(){
  document.querySelectorAll('.nesovi-steal-grab').forEach(function(b){
    if(b.dataset.nesoviInit)return;b.dataset.nesoviInit='1';
    b.addEventListener('click',function(){
      var vid=b.dataset.vid;if(!vid)return;
      b.disabled=true;var orig=b.textContent;b.textContent='Adding\u2026';
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:parseInt(vid),quantity:1})})
        .then(function(r){return r.json()})
        .then(function(){
          b.textContent='Added \u2713';
          return fetch('/cart.js').then(function(r){return r.json()}).then(function(cart){
            document.dispatchEvent(new CustomEvent('cart:update',{bubbles:true,detail:{resource:cart,data:{source:'nesovi-steal'}}}));
            setTimeout(function(){b.disabled=false;b.textContent=orig;},1500);
          });
        }).catch(function(){b.disabled=false;b.textContent=orig;});
    });
  });
})();
{% endjavascript %}
{% schema %}
{
  "name": "NESOVI Steal Deal",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Steal Deal"},
    {"type": "text", "id": "emoji", "label": "Emoji", "default": "🔥"},
    {"type": "collection", "id": "collection", "label": "Collection to pull from"},
    {"type": "text", "id": "tag", "label": "Filter by tag (optional)", "info": "e.g. steal-deal — leave blank to show all products in collection"},
    {"type": "range", "id": "limit", "label": "Max products", "min": 2, "max": 8, "step": 1, "default": 4}
  ],
  "presets": [{"name": "NESOVI Steal Deal"}]
}
{% endschema %}